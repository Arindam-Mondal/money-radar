# Money Radar configuration. Copy to .env and fill in.
# Any secret can instead be supplied as <NAME>_FILE=/path/to/file (Docker secrets).

# --- Privacy guard (CFG-3): local | hybrid. Does not choose providers. ---
PRIVACY_MODE=local

# --- Classifier, System One (CFG-1): jev | laya ---
CLASSIFIER_PROVIDER=laya
CLASSIFIER_BASE_URL=http://laya:8080
CLASSIFIER_MODEL=
CLASSIFIER_API_KEY=

# --- Query agent LLM (CFG-2): anthropic | ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://ollama:11434
ANTHROPIC_API_KEY=

# --- Extraction fallback (EXT-2): always local Ollama; empty disables ---
EXTRACTION_FALLBACK_MODEL=
OLLAMA_BASE_URL=http://ollama:11434

# --- Notifier: ntfy | whatsapp | none ---
NOTIFIER=none
NTFY_URL=
NTFY_TOPIC=
WHATSAPP_TOKEN=
WHATSAPP_TO=

# --- Postgres (db container) ---
# Read ONLY on first start (empty volume). Changing them later has no effect.
POSTGRES_USER=money_radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=money_radar

# --- Database URLs used by api/worker ---
# Host is "db" (the Compose service name), port 5432 (inside the Docker network).
# Single user until step 8.4 splits roles into mr_api / mr_worker / mr_agent_ro.
DATABASE_URL_API=postgresql+psycopg://money_radar:change-me@db:5432/money_radar
DATABASE_URL_WORKER=postgresql+psycopg://money_radar:change-me@db:5432/money_radar

# --- Keys: 32 random bytes, base64. Generate with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep these out of backups. Changing HMAC_KEY changes every token.
VAULT_KEY=
HMAC_KEY=

# --- Gmail ---
GMAIL_TOKEN_FILE=/run/secrets/gmail_token.json

# --- Scheduling ---
POLL_INTERVAL_SECONDS=120
DAILY_REPORT_TIME=21:00
TZ=Asia/Kolkata

# --- Region packs (comma list) ---
REGION_PACKS=india

# --- Docker Compose profiles for the self-hosted providers you chose ---
COMPOSE_PROFILES=ollama,laya
